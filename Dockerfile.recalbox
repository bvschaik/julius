# syntax=docker/dockerfile:1

FROM --platform=linux/arm64 docker.io/library/ubuntu:24.04 AS arm64-source

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN echo 'Acquire::https::Verify-Peer "false";' > /etc/apt/apt.conf.d/99verify-ssl && \
    echo 'Acquire::https::Verify-Host "false";' >> /etc/apt/apt.conf.d/99verify-ssl

RUN apt-get update && apt-get install -y \
    qemu-user-static \
    python3-minimal \
    && rm -rf /var/lib/apt/lists/*

RUN dpkg --add-architecture arm64 && \
    sed -i '/^Types: deb/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources

COPY --from=arm64-source /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/arm64.sources

RUN sed -i '/^Types: deb/a Architectures: arm64' /etc/apt/sources.list.d/arm64.sources

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    libsdl2-dev:arm64 \
    libsdl2-mixer-dev:arm64 \
    libpng-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=aarch64-linux-gnu-gcc
ENV CXX=aarch64-linux-gnu-g++
ENV STRIP=aarch64-linux-gnu-strip
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig

WORKDIR /src

ENTRYPOINT ["/bin/bash", "-c", "\
    cmake -B build \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
        -DCMAKE_FIND_ROOT_PATH=/usr/lib/aarch64-linux-gnu \
        -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
        -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY && \
    cmake --build build --config Release -j$(nproc) && \
    $STRIP build/julius \
"]
